# Copy to .dev.vars for Wrangler local use. Use wrangler secret put in production.
DISCORD_PUBLIC_KEY=REPLACE_WITH_DISCORD_ED25519_PUBLIC_KEY
DISCORD_APPLICATION_ID=REPLACE_WITH_DISCORD_APPLICATION_ID
DISCORD_CLIENT_ID=REPLACE_WITH_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=REPLACE_WITH_DISCORD_CLIENT_SECRET
DISCORD_BOT_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Local origin only; configure production APP_ORIGIN in wrangler.jsonc.
APP_ORIGIN=http://localhost:8787
