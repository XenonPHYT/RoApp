{
  "name": "roapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir .build",
    "deploy": "npm run build && wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir .build",
    "register": "node scripts/register-commands.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "eslint": "^9.0.0",
    "miniflare": "^5.20261110.2-beta",
    "prettier": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
