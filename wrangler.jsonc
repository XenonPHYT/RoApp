{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roapp",
  "main": "src/index.js",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "APP_ORIGIN": "https://roapp.urandom268.workers.dev/",
    "SESSION_HOURS": "8",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roapp-db",
      "database_id": "ae7c270f-bbe4-457b-8e06-3f47e6214ae0",
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
}
